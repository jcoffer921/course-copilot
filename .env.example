ANTHROPIC_API_KEY=sk-ant-...

# Google Sign-In (see README "Setup" for how to obtain these from the
# Google Cloud Console OAuth client).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# "allowlist" for a private beta or "open" for any verified Google identity.
ONTRACK_ADMISSION_MODE=allowlist
ONTRACK_LOGIN_RATE_LIMIT=10
ONTRACK_LOGIN_RATE_WINDOW_SECONDS=300

# Comma-separated allow-list of Google account emails permitted to sign in.
# Fails closed by design: empty/unset blocks everyone, not a bug to work around.
ALLOWED_GOOGLE_EMAILS=you@example.com,teammate@example.com

# Production-only Django security settings.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Private material upload and processing bounds.
ONTRACK_MAX_UPLOAD_BYTES=10485760
ONTRACK_MATERIAL_PROCESSING_TIMEOUT_SECONDS=90

# Email of the Django user the CLI management commands (extract_syllabus, chunk_notes,
# ask, quiz, mastery, references, reminders, sessions, domains, grades) operate as.
# These commands are dev/debug tools only, not used by real students. Must match a
# user who has already signed in through the web UI at least once.
CLI_OWNER_EMAIL=you@example.com
